# ─────────────────────────────────────────────────────────────
# Vision Saudi — environment configuration
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────

# Resend (https://resend.com) — used by app/api/contact/route.ts to email
# contact-form submissions. Create an account and generate an API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form lead notifications are delivered.
CONTACT_NOTIFICATION_EMAIL=advisory@visionsaudi.com

# Sender address shown on lead notification emails.
#
# IMPORTANT: the default sandbox sender below can ONLY deliver to the email
# address the Resend account was registered with. Until a custom domain is
# verified, real leads sent to any other address are silently dropped.
#
# To go live:
#   1. Resend dashboard -> Domains -> Add Domain (e.g. visionsaudi.com)
#   2. Add the DKIM/SPF DNS records Resend provides
#   3. Wait for "Verified", then set this to an address on that domain:
#        CONTACT_FROM_EMAIL=Vision Saudi <advisory@visionsaudi.com>
CONTACT_FROM_EMAIL=Vision Saudi <onboarding@resend.dev>

# Lead storage — every contact-form submission is also saved to a Google Sheet,
# so a lead is never lost if the email fails. Setup steps: docs/google-sheet-leads.gs
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Public site URL (canonical links, sitemap, structured data). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://visionsaudi.com

# Google Analytics 4 measurement ID. Loads only after the visitor accepts cookies.
NEXT_PUBLIC_GA_ID=

# Calendly or Cal.com scheduling link. The "Book a call" section stays hidden until set.
NEXT_PUBLIC_BOOKING_URL=
